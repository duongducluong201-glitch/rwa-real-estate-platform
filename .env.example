# ==============================================================================
# CẤU HÌNH HỆ THỐNG TOKEN HÓA BẤT ĐỘNG SẢN (RWA REAL ESTATE PLATFORM — OFFICIAL)
# Sao chép tệp này thành .env và điền thông tin thực tế trước khi khởi chạy
# ==============================================================================

# 1. Cơ sở dữ liệu (PostgreSQL khuyến nghị cho Production, SQLite cho Lab cục bộ)
DATABASE_URL=sqlite:///./rwa_platform.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/rwa_platform

# 2. Bảo mật Phiên & Kho KYC Mã hóa AES-256-GCM
JWT_SECRET=rwa-real-estate-session-secret-2026
KYC_VAULT_SECRET=rwa-kyc-vault-aes256-gcm-secret-2026

# 3. Node EVM Cục bộ Anvil (Foundry)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Khóa bí mật 5 tài khoản khởi tạo mặc định trên Anvil
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
COMPLIANCE_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
INVESTOR_A_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
INVESTOR_B_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# 4. Pinata IPFS (Để trống nếu dùng kho lưu trữ cục bộ IPFS Gateway tích hợp)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# 5. Dịch vụ gửi Mã OTP 6 số & Biên lai Thanh toán về Gmail
# Cách A: Google Apps Script Web App (Miễn phí, không cần App Password)
GOOGLE_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec
GOOGLE_SCRIPT_SECRET=RWA_DEMO_SECRET_2026

# Cách B: Gmail SMTP trực tiếp (Tùy chọn thay thế Cách A)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME="RWA Real Estate Tokenization Platform"
